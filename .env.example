# Copy to .env for local development. Never commit .env or real credentials.
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
DATABASE_URL=postgresql://localhost:5432/geminio_dev
REDIS_URL=redis://localhost:6379
SESSION_SECRET=
WORKER_INTERNAL_SECRET=
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
DOCKER_BIN=docker
AI_SANDBOX_IMAGE=geminio-ai-sandbox:latest
# Legacy edge-service credential; configure only if that service is intentionally deployed.
CHIXUS_ADMIN_PASSKEY=
